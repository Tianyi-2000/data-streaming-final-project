# Copy this file to `.env` and fill in values. NEVER commit the real `.env`.
# For the local Redpanda setup below, the defaults work as-is (no secrets).

# --- Kafka broker (local Redpanda via docker-compose) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PLAY_EVENTS_TOPIC=play-events
TRACK_ACTIVITY_TOPIC=track-activity

# --- MusicBrainz fetch (only needed to re-fetch the catalog) ---
# A contact (email or URL) is required in the MusicBrainz API User-Agent.
MUSICBRAINZ_CONTACT=you@example.com

# --- Producer replay ---
REPLAY_SEED=7
